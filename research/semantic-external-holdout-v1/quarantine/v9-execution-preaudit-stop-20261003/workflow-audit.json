{
  "name": "Trackcade V9 provider-free execution audit",
  "on": {
    "push": {
      "branches": [
        "trackcade-semantic-external-holdout-v1"
      ],
      "paths": [
        "research/semantic-external-holdout-v1/execute_stage1_v9_grounded_v1.py",
        "research/semantic-external-holdout-v1/test_stage1_v9_execution_v1.py",
        "research/semantic-external-holdout-v1/audit_stage1_v9_execution_v1.py",
        "research/semantic-external-holdout-v1/STAGE1_V9_EXECUTION_POLICY_V1.json",
        ".github/workflows/trackcade-semantic-external-stage1-v9-grounded-v1.yml",
        ".github/workflows/trackcade-semantic-external-stage1-v9-grounded-audit-v1.yml"
      ]
    }
  },
  "permissions": {
    "contents": "read",
    "actions": "read"
  },
  "jobs": {
    "audit": {
      "runs-on": "ubuntu-24.04",
      "timeout-minutes": 15,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "E": "research/semantic-external-holdout-v1/execute_stage1_v9_grounded_v1.py",
        "V9_SOURCE_PREP": "/tmp/v9-grounded-prep",
        "V9_WORK": "/tmp/v9-grounded"
      },
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "fetch-depth": 0,
            "persist-credentials": false,
            "sparse-checkout-cone-mode": false,
            "sparse-checkout": "/.github/workflows/trackcade-semantic-external-stage1-v9-grounded-audit-v1.yml\n/.github/workflows/trackcade-semantic-external-stage1-v9-grounded-v1.yml\n/research/learned-interpretation-v1/build_learned_request_v1.py\n/research/learned-interpretation-v1/build_learned_request_v2.py\n/research/learned-interpretation-v1/build_learned_request_v3.py\n/research/learned-interpretation-v1/build_learned_request_v5.py\n/research/learned-interpretation-v1/build_learned_request_v6.py\n/research/learned-interpretation-v1/build_learned_request_v7.py\n/research/learned-interpretation-v1/openai_responses_adapter_v1.py\n/research/learned-interpretation-v1/validate_learned_proposal_v1.py\n/research/learned-interpretation-v1/validate_learned_proposal_v3.py\n/research/learned-interpretation-v1/validate_learned_proposal_v7.py\n/research/semantic-external-holdout-v1/STAGE1_MIXED_V7_V8_PREDICTION_MANIFEST_V1.json\n/research/semantic-external-holdout-v1/STAGE1_V9_EXECUTION_POLICY_V1.json\n/research/semantic-external-holdout-v1/STAGE1_V9_GROUNDED_CONTRACT_V1.json\n/research/semantic-external-holdout-v1/STAGE1_V9_GROUNDED_MAPPING_V1.json\n/research/semantic-external-holdout-v1/STAGE1_V9_GROUNDED_SEMANTIC_DIFF_V1.patch\n/research/semantic-external-holdout-v1/audit_stage1_v9_execution_v1.py\n/research/semantic-external-holdout-v1/build_stage1_v9_grounded_v1.py\n/research/semantic-external-holdout-v1/execute_stage1_v9_grounded_v1.py\n/research/semantic-external-holdout-v1/run_stage1_v7_remaining49_case_v1.py\n/research/semantic-external-holdout-v1/run_stage1_v9_grounded_v1.py\n/research/semantic-external-holdout-v1/stage_stage1_v9_grounded_v1.py\n/research/semantic-external-holdout-v1/test_stage1_v9_execution_v1.py\n/research/semantic-external-holdout-v1/test_stage1_v9_grounded_contract_v1.py\n/research/semantic-external-holdout-v1/test_stage1_v9_grounded_execution_v1.py"
          }
        },
        {
          "uses": "actions/download-artifact@v4",
          "with": {
            "name": "trackcade-semantic-external-stage1-v7-prep-v1",
            "path": "/tmp/v9-source-original",
            "repository": "${{ github.repository }}",
            "run-id": 36915758639,
            "github-token": "${{ github.token }}"
          }
        },
        {
          "uses": "actions/download-artifact@v4",
          "with": {
            "name": "trackcade-semantic-external-stage1-v7-flex8192-prep-v1",
            "path": "/tmp/v9-flex-original",
            "repository": "${{ github.repository }}",
            "run-id": 36920081360,
            "github-token": "${{ github.token }}"
          }
        },
        {
          "run": "python -B \"$E\" prep"
        },
        {
          "run": "python -B research/semantic-external-holdout-v1/audit_stage1_v9_execution_v1.py --report /tmp/v9-execution-audit.json"
        },
        {
          "uses": "actions/upload-artifact@v4",
          "with": {
            "name": "trackcade-stage1-v9-execution-provider-free-audit-v1",
            "path": "/tmp/v9-execution-audit.json",
            "if-no-files-found": "error",
            "retention-days": 90
          }
        }
      ]
    }
  }
}
